APP_ENV=development
LOG_LEVEL=INFO
API_KEY=local-development-key
# Bind this API instance to the tenant represented by its credential.
# RAG_TENANT_ID=default
MAX_UPLOAD_BYTES=5000000
MAX_QUERY_LENGTH=2000
TOP_K=5
MIN_RELEVANCE_SCORE=0.10
# Set these when adding a hosted model/vector-store adapter:
# OPENAI_API_KEY=
# QDRANT_URL=http://localhost:6333
