# Copy to .env and replace every value. .env is Git-ignored.

# Postgres owner (runs migrations) and restricted application role.
POSTGRES_PASSWORD=change-me-owner
RAG_APP_DB_PASSWORD=change-me-app

# Single-key mode: one API credential bound to one tenant.
RAG_API_KEY=change-me-api-key
RAG_TENANT_ID=default
# Multi-tenant mode instead: keys, tenants, users and groups in a JSON file
# created with scripts/create_api_key.py (keep it under the ignored secrets/).
# RAG_API_KEYS_FILE=/run/secrets/api-keys.json

# Host ports. Change POSTGRES_PORT if another Postgres already uses 5432.
API_PORT=8000
POSTGRES_PORT=5432

# Running api.py outside Docker against the Compose database:
# DATABASE_URL=postgresql://rag_app:change-me-app@localhost:5432/rag

# Optional OpenAI-compatible generation provider (OpenAI, Ollama, vLLM, LM Studio).
# Without these the API uses the free extractive answerer.
# RAG_MODEL_BASE_URL=https://api.openai.com/v1
# RAG_MODEL_API_KEY=
# RAG_MODEL_NAME=
# Optional second model tried when the first fails (e.g. a local Ollama).
# RAG_FALLBACK_MODEL_BASE_URL=http://host.docker.internal:11434/v1
# RAG_FALLBACK_MODEL_API_KEY=ollama
# RAG_FALLBACK_MODEL_NAME=llama3.2
# Budgets, timeouts, and prices used for cost accounting (USD per million tokens).
# RAG_MAX_CONTEXT_TOKENS=3000
# RAG_MAX_HISTORY_TOKENS=1000
# RAG_MAX_OUTPUT_TOKENS=512
# RAG_MODEL_TIMEOUT_SECONDS=30
# RAG_GENERATION_DEADLINE_SECONDS=45
# RAG_MODEL_INPUT_PRICE_PER_MTOK=0
# RAG_MODEL_OUTPUT_PRICE_PER_MTOK=0

# Set to 0 on API-only replicas so they do not consume ingestion jobs.
# RAG_RUN_WORKER=1

# Evidence gates (defaults are calibrated by evals/evaluate.py).
# RAG_MIN_SCORE=0.40
# RAG_RELATIVE_SCORE=0.8
